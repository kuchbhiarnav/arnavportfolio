---
import Base from '../layouts/Base.astro';
---
<Base path="/404" title="Page not found" noindex>
  <article class="plain" style="padding-bottom:140px">
    <p class="meta">404</p>
    <h1>That page isn't here</h1>
    <p>It may have moved when the site was rebuilt. These will get you back on track.</p>
    <div class="btn-row" style="margin-top:12px">
      <a class="btn" href="/">Home</a>
      <a class="btn btn--ghost" href="/projects">Work</a>
      <a class="btn btn--ghost" href="/research">Insights</a>
      <button class="btn btn--ghost" type="button" data-open-assistant>Ask the assistant</button>
    </div>
  </article>
</Base>
