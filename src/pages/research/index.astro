---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import journal from '../../assets/brand/journal-logo.png';
const items = (await getCollection('research', (r) => !r.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base path="/research" title="Research & Insights" description="Conference abstracts and co-authored papers on arsenic and groundwater decision support and deepfake detection, with accurate author order, venues and dates.">
  <h1 class="sr-only">Research &amp; Insights</h1>
  <div class="insights-hero reveal"><Image src={journal} alt="Arnav's Journal: earth, tech, data" width={2000} widths={[750, 1500, 2000]} sizes="100vw" loading="eager" /></div>

  <section class="insights-grid-section" aria-labelledby="latest">
    <h2 class="insights-grid-heading" id="latest">Latest Articles &amp; Research</h2>
    <div class="insights-grid">
      {items.map((r, i) => (
        <article class:list={['article-card', 'reveal', { 'card-full': i === items.length - 1 && items.length % 2 === 1 }]}>
          <div class="article-thumb">
            <Image src={r.data.cover} alt={r.data.coverAlt} width={i === items.length - 1 && items.length % 2 === 1 ? 1500 : 800} loading={i < 2 ? 'eager' : 'lazy'} />
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 class="article-title"><a href={`/research/${r.id}`}>{r.data.cardTitle}</a></h3>
            <div class="article-meta"><span>Research</span><span aria-hidden="true">·</span><span>{r.data.readTime}</span></div>
          </div>
          <p class="article-excerpt">{r.data.cardLine}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
