---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { caseCovers } from '../data/covers';
interface Props { exclude: string }
const { exclude } = Astro.props;
const cases = (await getCollection('caseStudies', (c) => !c.data.draft)).map((c) => ({
  href: `/projects/${c.id}`, title: c.data.shortTitle, desc: c.data.cardLine ?? c.data.summary, tag: 'Work Highlight', order: c.data.order,
  logo: caseCovers[c.id]?.logo, logoAlt: caseCovers[c.id]?.alt ?? '', img: undefined as ImageMetadata | undefined, imgAlt: '', thumb: undefined as string | undefined,
}));
// The numbered thumbnail (/media/projects/N-thumb.jpg) is the same picture the Projects page shows, N being the project's position there.
const projects = (await getCollection('work', (w) => !w.data.draft)).sort((a, b) => a.data.order - b.data.order).map((w, idx) => ({
  href: `/projects/project/${w.id}`, title: w.data.cardTitle ?? w.data.title, desc: w.data.cardContext ?? w.data.summary, tag: 'Project', order: 10 + w.data.order,
  logo: undefined as ImageMetadata | undefined, logoAlt: '', img: undefined as ImageMetadata | undefined, imgAlt: `Preview of ${w.data.cardTitle ?? w.data.title}`, thumb: `/media/projects/${idx + 1}-thumb.jpg`,
}));
const items = [...cases, ...projects].filter((i) => i.href !== exclude).sort((a, b) => a.order - b.order).slice(0, 3);
---
<section class="recent-articles" aria-labelledby="recent-h">
  <div class="recent-inner">
    <div class="recent-header">
      <h2 class="recent-title" id="recent-h">Some more work and projects</h2>
      <a class="recent-view-all" href="/projects">All projects</a>
    </div>
    <div class="recent-grid">
      {items.map((i) => (
        <article class="recent-card">
          <div class="recent-thumb">
            {i.logo ? <div class="cover-logo"><Image src={i.logo} alt={i.logoAlt} width={480} loading="lazy" /></div>
              : i.thumb ? <img src={i.thumb} alt={i.imgAlt} width="1280" height="720" loading="lazy" decoding="async" /> : null}
          </div>
          <h3 class="recent-card-title"><a href={i.href}>{i.title}</a></h3>
          <p class="recent-card-desc">{i.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
