---
import { site } from '../data/site';
---
<section class="consent" id="consent" aria-labelledby="consent-title" data-ga-id={site.analyticsId} hidden>
  <p id="consent-title"><strong>Analytics, only if you agree.</strong></p>
  <p>I would like to use Google Analytics to see which pages are useful. It sets cookies and sends page-view data to Google. It is off unless you accept. The assistant's questions and your contact messages are never sent to analytics. <a href="/privacy#analytics">Details</a></p>
  <div class="btn-row">
    <button type="button" class="btn" data-consent="granted">Accept analytics</button>
    <button type="button" class="btn btn--ghost" data-consent="denied">Decline</button>
  </div>
</section>
<script>
  import '../scripts/consent';
</script>
