---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  n: string;
  name: string;
  href?: string;
  dialog?: string; // id of a <dialog> to open instead of navigating
  cover?: ImageMetadata;
  coverAlt?: string;
  logo?: ImageMetadata;
  logoAlt?: string;
  video?: string; // base path of a silent looping preview, e.g. /media/projects/1
  context?: string;
  award?: string;
  all?: boolean; // Work-page variant
  kind?: string;
}
const { n, name, href, dialog, cover, coverAlt = '', logo, logoAlt = '', video, context, award, all = false, kind } = Astro.props;
---
<article class:list={[all ? 'all-project-card' : 'project-card', 'reveal']} data-kind={kind}>
  <div class={all ? 'all-project-img' : 'project-img'}>
    {video ? <div class="tile-media project-img-inner">{logo ? <div class="cover-logo tile-thumb"><Image src={logo} alt={logoAlt} width={640} /></div> : <img class="tile-thumb" src={`${video}-thumb.jpg`} alt={coverAlt} width="1280" height="720" loading="lazy" />}<video class="tile-video" src={`${video}.mp4`} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video></div>
      : cover ? <Image class="project-img-inner" src={cover} alt={coverAlt} width={1100} widths={[640, 1100]} sizes="(max-width: 768px) 100vw, 50vw" loading="lazy" />
      : logo ? <div class="cover-logo project-img-inner"><Image src={logo} alt={logoAlt} width={640} /></div> : null}
  </div>
  <div class={all ? 'all-project-footer' : 'project-footer'}>
    <div class={all ? 'all-project-meta' : undefined}>
      <span class={all ? 'all-project-num' : 'project-num'}>{n}</span>
      {all && context && <span class="all-project-ctx">{context}</span>}
      {award && <span class="award-pill">{award}</span>}
    </div>
    <h3 class={all ? 'all-project-name' : 'project-name'}>
      {href
        ? <a class="tile-link" href={href}>{name}</a>
        : <button class="tile-link link-btn" type="button" data-dialog-open={dialog} style="font:inherit;color:inherit;text-decoration:none;text-align:right">{name}<span class="sr-only"> (opens details)</span></button>}
    </h3>
    {all && <span class="all-project-arrow" aria-hidden="true">↗</span>}
  </div>
</article>

<script>
    // Hover (or keyboard focus) on a project card plays its video over the thumbnail; leaving stops it and shows the thumbnail again.
    // Reduced motion and touch screens keep the thumbnail.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLElement>('.all-project-card').forEach((card) => {
        const v = card.querySelector<HTMLVideoElement>('.tile-video');
        if (!v) return;
        const start = () => { v.play().then(() => card.classList.add('is-playing')).catch(() => {}); };
        const stop = () => { v.pause(); card.classList.remove('is-playing'); v.currentTime = 0; };
        card.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') start(); });
        card.addEventListener('pointerleave', stop);
        card.addEventListener('focusin', start);
        card.addEventListener('focusout', stop);
      });
    }
</script>
