{
  "name": "arnavs-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "wrangler types --check >/dev/null 2>&1 || wrangler types >/dev/null; astro sync && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/build-assets.mjs",
    "verify": "npm run check && npm run build && npm run test",
    "types": "wrangler types",
    "eval:assistant": "node scripts/eval-assistant.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/radio-canada-big": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/lisu-bosa": "^5.3.0",
    "astro": "^7.4.7",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
