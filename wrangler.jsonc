{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arnavs-archive",
  // Matches the workerd build bundled with this Wrangler version (checked 2026-11-07).
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Strict, shared daily budget for AI requests. Durable Objects are available on the Free plan
  // with the SQLite backend only (verified 2026-11-07).
  "durable_objects": { "bindings": [{ "name": "USAGE_GATE", "class_name": "UsageGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageGate"] }],
  // Non-secret defaults. Secrets (GEMINI_API_KEY, RATE_SALT) are set with `wrangler secret put`.
  // AI is OFF by default: AI mode is opt-in (see docs/05-setup-and-environment.md).
  "vars": {
    "AI_ENABLED": "false",
    // Ordered pool; each model has its own daily and per-minute cap in src/lib/models.ts, below Google's free-tier quota.
    "GEMINI_MODELS": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
    // Visitor and site-wide caps on top of the per-model caps.
    "AI_GLOBAL_DAILY_LIMIT": "800",
    "AI_CLIENT_DAILY_LIMIT": "20",
    "AI_CLIENT_PER_MINUTE": "3",
    "AI_GLOBAL_PER_MINUTE": "20"
  }
  // Optional extra layer (approximate, per-location; Free-plan availability not confirmed):
  // "ratelimits": [{ "name": "ASK_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }]
}
